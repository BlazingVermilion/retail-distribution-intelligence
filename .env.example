# Fixture demo needs no .env. For a new full installation copy this file
# to .env, then supply distinct local passwords before running Compose.
POSTGRES_DB=retail_analytics
POSTGRES_USER=postgres
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
DBT_ENV_SECRET_PASSWORD=
PG_PUBLISHER_PASSWORD=
PG_SNAPSHOT_PASSWORD=
# airflow/setup_local.py appends the four Airflow secrets to the local .env.
# Optional Snowflake account and encrypted key paths are set outside the repo.
